{
  "name": "industrial-nexus",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "cd apps/backend && npm run dev",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:admin": "cd apps/admin-pwa && npm run dev",
    "dev:client": "cd apps/client-pwa && npm run dev",
    "dev:driver": "cd apps/driver-pwa && npm run dev",
    "dev:landing": "cd apps/landing-page && npm run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "cd apps/backend && npx prisma migrate dev",
    "db:generate": "cd apps/backend && npx prisma generate",
    "db:seed": "cd apps/backend && npx prisma db seed",
    "db:studio": "cd apps/backend && npx prisma studio"
  },
  "devDependencies": {
    "fast-glob": "^3.3.2",
    "sharp": "^0.35.2",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
