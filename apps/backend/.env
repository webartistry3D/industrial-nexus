# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/industrial_nexus?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis - will use in-memory fallback if not available
REDIS_ENABLED="false"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3002,http://localhost:3003"
