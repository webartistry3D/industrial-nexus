# Database
DATABASE_URL="postgresql://user:password@localhost:5432/industrial_nexus?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Mapbox (same pk.* public token as frontend)
MAPBOX_TOKEN=""

# Application
PORT=3001
NODE_ENV="development"

# Google Cloud Storage (for document storage)
# Set STORAGE_PROVIDER=gcs to enable GCS in any environment; otherwise GCS is
# used automatically when NODE_ENV=production. Falls back to local disk.
STORAGE_PROVIDER=""
GCP_PROJECT_ID=""
GCS_BUCKET_NAME="industrial-nexus-documents"
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GCS_SIGNED_URL_EXPIRATION_MINUTES=15

# SMTP Email (leave SMTP_HOST empty to disable email in dev)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Industrial Nexus"
SMTP_FROM_EMAIL="noreply@industrialnexus.com"

# Frontend URL (used in reset-password email links)
APP_URL="http://localhost:3000"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# Maps services - open source routing/geocoding
VALHALLA_URL=http://localhost:8002
NOMINATIM_URL=https://nominatim.openstreetmap.org
